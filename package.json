{
  "name": "drhoodskin",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bash scripts/cloud-setup.sh",
    "dev": "node scripts/dev/watch.js",
    "dev:once": "pnpm build && node scripts/dev/start.js",
    "dev:reset": "node scripts/dev/reset.js",
    "build": "vp build",
    "start": "node .output/server/index.mjs",
    "test": "pnpm build && pnpm test:helpers && node --test --test-concurrency=1 test/e2e/*.test.js",
    "test:helpers": "vp test run --config helpers.config.ts",
    "check": "node scripts/check.js",
    "typecheck": "tsc",
    "lint": "vp lint src server.ts scripts test app/scripts",
    "browser:install": "playwright install chromium",
    "format": "vp fmt",
    "availability:poll": "cd app && node scripts/poll-availability.ts --force",
    "availability:report": "cd app && node scripts/availability-report.ts",
    "activity:export": "node scripts/activity-export.js",
    "activity:report": "node scripts/activity-report.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/router-core": "1.171.39",
    "lucide-react": "^0.545.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "nitro": "npm:nitro-nightly@3.0.1-20261020-162248-8b0fa015",
    "playwright": "1.64.1",
    "tailwindcss": "4.1.18",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "packageManager": "pnpm@10.29.2"
}
