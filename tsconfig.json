{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["vite-plus/client", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app/scripts/**/*.ts",
    "scripts/*.ts",
    "vite.config.ts",
    "helpers.config.ts",
    "server.ts"
  ]
}
